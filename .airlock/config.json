{
  "schema": "airlock.config.v1",
  "parallelism": 4,
  "protected_paths": [
    ".github/**",
    ".airlock/**",
    "tests/**",
    "pyproject.toml",
    "src/airlock/runner.py"
  ],
  "verification": {
    "static_commands": [],
    "test_commands": [
      [
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ]
    ],
    "target_commands": [
      [
        "python",
        ".airlock/checks/init_next_step.py"
      ]
    ],
    "timeout_seconds": 1200,
    "coverage_mode": "changed-module-reference"
  },
  "providers": {
    "hermes": {
      "command": [
        "python",
        ".airlock/checks/hermes_live_001_worker.py",
        "{prompt}"
      ],
      "pass_env": [
        "HERMES_HOME"
      ],
      "timeout_seconds": 2700
    }
  },
  "init_baseline": {
    "commit": "1c10931d6453e6377219475db816e4423366f6e3",
    "commands": [],
    "green": true
  }
}
