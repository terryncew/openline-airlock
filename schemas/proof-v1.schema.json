{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenLine Airlock proof receipt v1",
  "type": "object",
  "required": ["alg", "payload", "signature"],
  "properties": {
    "alg": {"const": "HMAC-SHA256"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "required": [
        "schema",
        "decision",
        "run_id",
        "base_commit",
        "candidate_commit",
        "changed_paths",
        "protected_patterns",
        "baseline",
        "evidence",
        "claim_boundary"
      ],
      "properties": {
        "schema": {"const": "airlock.proof.v1"},
        "decision": {"const": "ADMITTED"},
        "base_commit": {"type": "string"},
        "candidate_commit": {"type": "string"},
        "changed_paths": {"type": "array", "items": {"type": "string"}},
        "protected_patterns": {"type": "array", "items": {"type": "string"}},
        "claim_boundary": {"type": "string"}
      }
    }
  }
}
