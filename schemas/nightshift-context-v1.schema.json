{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/terryncew/openline-airlock/schemas/nightshift-context-v1.schema.json",
  "title": "OpenLine Airlock Nightshift run context",
  "type": "object",
  "required": [
    "schema",
    "worker",
    "scripted_interface",
    "models",
    "profiles",
    "attempts_per_generation",
    "persistent_worker_state",
    "worker_state_controls_objective",
    "worker_state_controls_evaluator",
    "worker_state_controls_promotion"
  ],
  "properties": {
    "schema": {"const": "airlock.nightshift.context.v1"},
    "worker": {"const": "hermes"},
    "scripted_interface": {"const": "-z"},
    "models": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "profiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "attempts_per_generation": {"type": "integer", "minimum": 1},
    "persistent_worker_state": {"const": true},
    "worker_state_controls_objective": {"const": false},
    "worker_state_controls_evaluator": {"const": false},
    "worker_state_controls_promotion": {"const": false},
    "parallel_profile_rule": {"type": "string"},
    "authority_boundary": {"type": "string"},
    "time_boundary": {"type": "string"}
  },
  "additionalProperties": true
}
